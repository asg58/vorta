# VORTA Inference Engine Environment Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Conversation brain (Claude) - what the assistant actually says
ANTHROPIC_API_KEY=your-anthropic-api-key-here
VORTA_LLM_MODEL=claude-fable-5-2
# low = fastest replies (default); raise to medium/high for harder questions
VORTA_LLM_EFFORT=low

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
DEBUG=true

# Speech Services
WHISPER_MODEL=base
TTS_MODEL=tts-1

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Database Configuration
DATABASE_URL=postgresql://vorta_user:password@postgres:5432/vorta_db
